# ─────────────────────────────────────────────────────────────
# Concordance — Bible Quiz round scorer
# Flutter app targeting Android, Windows, and Linux.
#
# Base content follows the official `flutter create` templates
# (root, android, windows, linux); platform folders generated by
# Flutter carry their own .gitignore files with the same rules.
#
# NOTE: pubspec.lock is intentionally NOT ignored — this is an
#       application, so dependency versions should be pinned.
# ─────────────────────────────────────────────────────────────

# ── Project-specific: licensed documents ──────────────────────
# The rulebook PDFs are (c) My Healthy Church, licensed "for local
# church use only" — never commit or redistribute them. Extracted
# rule text used for config also stays out of the repo (/tmp only).
docs/**/*.pdf
docs/**/*-Rules.txt
docs/**/rules-extracted*

# ── Project-specific: secrets & signing material ──────────────
# Android release keystore — see https://flutter.dev/to/reference-keystore
key.properties
*.jks
*.keystore
*.p12
*.pem
*.mobileprovision
secrets/
.env
.env.*
!.env.example

# ── Project-specific: release artifacts ───────────────────────
# CI-built APKs/installers are downloaded from GitHub Releases,
# not committed here.
dist/
*.apk
*.aab
*.msix
*.msixbundle
*.exe
*.AppImage
*.deb
*.rpm

# ── Miscellaneous (Flutter template) ──────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ── IntelliJ / Android Studio (Flutter template) ──────────────
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ── Flutter / Dart / Pub (Flutter template) ───────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── Android (mirrors android/.gitignore from the template) ────
gradle-wrapper.jar
.gradle/
captures/
gradlew
gradlew.bat
local.properties
GeneratedPluginRegistrant.java
.cxx/
# Kotlin incremental-compile session dir (Gradle plugin)
android/.kotlin/

# ── Windows (mirrors windows/.gitignore from the template) ────
**/flutter/ephemeral/
# Visual Studio user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
# Visual Studio build-related files
x64/
x86/
*.[Cc]ache
!*.[Cc]ache/

# ── Linux (mirrors linux/.gitignore from the template) ────────
# (**/flutter/ephemeral/ above covers both Windows and Linux)

# ── macOS / iOS (if those platforms are ever added) ───────────
macos/Pods/
macos/.symlinks/
**/Pods/
**/.symlinks/
*.moved-aside

# ── Flutter version manager (if adopted) ──────────────────────
.fvm/
!.fvm/fvm_config.json

# ── Other tooling ─────────────────────────────────────────────
node_modules/
__pycache__/
